\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces One generation step and the matching reveal step. Gray: the step has fewer than two candidates, so no bit is written or read. Blue: generation writes the current message bit by sampling inside one list. Green: reveal reads that bit back from the list which contains the observed token. $L_0$ is the list for bit 0. $L_1$ is the list for bit 1.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:flow}{{1}{2}{One generation step and the matching reveal step. Gray: the step has fewer than two candidates, so no bit is written or read. Blue: generation writes the current message bit by sampling inside one list. Green: reveal reads that bit back from the list which contains the observed token. $L_0$ is the list for bit 0. $L_1$ is the list for bit 1}{figure.caption.1}{}}
